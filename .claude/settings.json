{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push)", "Bash(git push -u origin:*)",
      "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git branch:*)", "Bash(git pull)",
      "Bash(git fetch:*)", "Bash(git init:*)", "Bash(git remote:*)", "Bash(git rev-parse:*)",
      "Bash(gh auth status)", "Bash(gh repo create:*)", "Bash(gh repo view:*)",
      "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh run list:*)", "Bash(gh run view:*)",
      "Bash(claude plugin validate:*)", "Bash(powershell -NoProfile:*)", "Bash(powershell.exe -NoProfile:*)"
    ],
    "ask": [
      "Bash(gh repo edit:*)", "Bash(gh release create:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)", "Bash(gh pr merge:*)", "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
